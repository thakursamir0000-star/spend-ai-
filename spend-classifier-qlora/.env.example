# Copy to .env and fill in. Only GROQ_API_KEY is required (for the baseline eval).

# Used by eval/baseline_eval.py (rule + GROQ baseline).
GROQ_API_KEY=gsk_...

# Inference routing (Phase 6 integration).
#   groq  -> rule-based + Groq LLM (current production path)
#   local -> fine-tuned Qwen2.5-1.5B + LoRA adapter (local, offline)
CATEGORIZER_MODE=groq

# Fine-tuned model settings (used by inference/classifier.py + eval/eval_finetuned.py).
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LORA_ADAPTER_PATH=outputs/qlora-transaction-classifier

# Optional: needed only if you download the base model via a gated repo.
HUGGINGFACE_TOKEN=
